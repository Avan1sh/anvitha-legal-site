# Set the real domain only after the public identity and content are approved.
PUBLIC_SITE_URL=https://example.org
PUBLIC_ENABLE_INDEXING=false

# Keep appointment collection off until the owner approves retention and privacy copy.
PUBLIC_APPOINTMENTS_ENABLED=false
PUBLIC_APPOINTMENT_PRIVACY_APPROVED=false
PUBLIC_APPOINTMENT_RETENTION_DAYS=

# Configure these in the PHP hosting environment, not in the public web directory:
# ANVITHA_APPOINTMENTS_ENABLED=false
# ANVITHA_APPOINTMENT_PRIVACY_APPROVED=false
# ANVITHA_APPOINTMENT_RETENTION_DAYS=
# ANVITHA_APPOINTMENT_FROM=website@anvithalegal.com
