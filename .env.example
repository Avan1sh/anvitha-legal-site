# Set the real domain only after the public identity and content are approved.
PUBLIC_SITE_URL=https://example.org
PUBLIC_ENABLE_INDEXING=false

# Keep appointment collection off until the privacy wording and purpose-based retention are confirmed.
PUBLIC_APPOINTMENTS_ENABLED=false
PUBLIC_APPOINTMENT_PRIVACY_APPROVED=false
PUBLIC_APPOINTMENT_RETENTION_POLICY=

# In ignored .env.local, use preview mode to test the form without email:
# PUBLIC_APPOINTMENT_PRIVACY_APPROVED=true
# PUBLIC_APPOINTMENT_RETENTION_POLICY=purpose
# LOCAL_APPOINTMENT_DELIVERY=preview
# For real localhost email, change delivery to smtp and add a Gmail sender's
# LOCAL_SMTP_USER and LOCAL_SMTP_APP_PASSWORD (a Google App Password).
# Configure these in the PHP hosting environment, not in the public web directory:
# ANVITHA_APPOINTMENTS_ENABLED=false
# ANVITHA_APPOINTMENT_PRIVACY_APPROVED=false
# ANVITHA_APPOINTMENT_RETENTION_POLICY=
# ANVITHA_APPOINTMENT_FROM=website@anvithalegal.com
