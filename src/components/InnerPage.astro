---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhosphorIcon from './PhosphorIcon.astro';
import { copy, facts, urlFor, type Locale, type PageKey } from '../lib/site';

interface Props {
  locale: Locale;
  page: Exclude<PageKey, 'home'>;
}
const { locale, page } = Astro.props;
const t = copy[locale];
const info =
  page === 'about'
    ? t.about
    : page === 'how-we-help'
      ? t.help
      : page === 'our-work'
        ? t.work
        : page === 'get-help'
          ? t.contact
          : page === 'faq'
            ? t.faq
            : page === 'privacy'
              ? t.privacy
              : t.disclaimer;
const eyebrow = 'eyebrow' in info ? info.eyebrow : facts.name;
const heading = 'heading' in info ? info.heading : '';
const intro = 'intro' in info ? info.intro : '';
const sections = 'sections' in info ? info.sections : [];
const isLegal = page === 'privacy' || page === 'disclaimer';
---

<BaseLayout locale={locale} page={page} title={info.title} description={info.description}>
  <section class:list={['inner-hero', 'page-wrap', { 'inner-hero-compact': isLegal }]}>
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {intro && <p class="inner-intro">{intro}</p>}
    </div>
    <div class="inner-hero-symbol" aria-hidden="true">
      <span>A.</span>
    </div>
  </section>

  {page === 'about' && (
    <>
      <section class="editorial-section section-pad page-wrap">
        <div class="about-who-grid">
          <h2>{t.about.who.title}</h2>
          <div>
            <p>{t.about.who.text}</p>
            <p>{t.about.who.name}</p>
          </div>
        </div>
        <div class="editorial-grid about-purpose-grid">
          {t.about.sections.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="principles-band">
        <div class="page-wrap">
          <p class="eyebrow">{locale === 'hi' ? 'हमारे मूल्य' : 'Our values'}</p>
          <dl class="values-grid">
            {t.about.principles.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd>{item.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
      <section class="trust-section section-pad page-wrap">
        <div>
          <p class="eyebrow">A S Godara Foundation Trust</p>
          <h2>{t.about.trust.title}</h2>
        </div>
        <div class="trust-body">
          <p>{t.about.trust.text}</p>
          <div class="registration-details">
            <h3>{t.about.trust.registrationTitle}</h3>
            <dl>
              <div>
                <dt>{t.about.trust.placeLabel}</dt>
                <dd>{t.about.trust.place}</dd>
              </div>
              <div>
                <dt>{t.about.trust.dateLabel}</dt>
                <dd>
                  <time datetime="2024-02-22">{t.about.trust.date}</time>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </section>
    </>
  )}

  {page === 'how-we-help' && (
    <section class="section-pad page-wrap">
      <div class="section-heading">
        <h2>
          {locale === 'hi'
            ? 'जिन सवालों पर हम दिशा बताते हैं'
            : 'Areas where we can offer direction'}
        </h2>
      </div>
      <div class="area-grid">
        {t.help.sections.map((item, i) => (
          <article>
            <span>0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <div class="soft-note">
        <p>{t.generalNotice}</p>
        <a class="text-link" href={urlFor('get-help', locale)}>
          {t.nav['get-help']}
          <PhosphorIcon name="arrow-right" />
        </a>
      </div>
    </section>
  )}

  {page === 'our-work' && (
    <>
      <section class="section-pad page-wrap">
        <div class="work-grid">
          {t.work.sections.map((item, i) => (
            <article class:list={['work-item', { 'work-item-featured': i === 0 }]}>
              <span class="card-number">0{i + 1}</span>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
        <p class="work-note">{t.work.note}</p>
      </section>
    </>
  )}

  {page === 'get-help' && (
    <section class="section-pad page-wrap contact-grid">
      <div>
        <div class="urgent-panel">
          <h2>{t.contact.urgentTitle}</h2>
          <p>{t.contact.urgentText}</p>
          <div class="urgent-actions">
            <a href={`tel:${facts.emergencyPhone}`} class="button button-light">
              {facts.emergencyPhone}
              <PhosphorIcon name="arrow-up-right" />
            </a>
            <a href={`tel:${facts.legalAidPhone}`} class="button button-outline">
              {facts.legalAidPhone}
              <PhosphorIcon name="arrow-up-right" />
            </a>
          </div>
        </div>
        <div class="contact-information">
          <h2>{locale === 'hi' ? 'सार्वजनिक संपर्क' : 'Direct contact'}</h2>
          {facts.phone ? (
            <a href={`tel:${facts.phone}`}>{facts.phone}</a>
          ) : (
            <p>{t.contact.contactPending}</p>
          )}
          {facts.email && <a href={`mailto:${facts.email}`}>{facts.email}</a>}
          {facts.address && <p>{facts.address}</p>}
          <a class="text-link" href={facts.legalAidUrl} target="_blank" rel="noopener noreferrer">
            {locale === 'hi' ? 'नालसा वेबसाइट देखें' : 'Visit the NALSA website'}
            <PhosphorIcon name="arrow-up-right" />
          </a>
        </div>
      </div>
      <div class="preparation-panel">
        <p class="eyebrow">{locale === 'hi' ? 'अगला कदम' : 'Next step'}</p>
        <h2>{t.contact.prepareTitle}</h2>
        <ol class="prepare-list">
          {t.contact.prepareItems.map((item, i) => (
            <li>
              <span>0{i + 1}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
        <p class="prepare-note">{t.contact.prepareNote}</p>
      </div>
    </section>
  )}

  {page === 'faq' && (
    <section class="section-pad page-wrap faq-page">
      <div class="faq-list">
        {t.faq.items.map((item) => (
          <details>
            <summary>
              {item.q}
              <PhosphorIcon name="plus" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {isLegal && (
    <section class="section-pad page-wrap legal-page">
      <div class="legal-grid">
        {sections.map((item) => (
          <section>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </section>
        ))}
      </div>
    </section>
  )}

  {page !== 'get-help' && !isLegal && (
    <section class="inner-cta">
      <div class="page-wrap">
        <h2>{t.home.ctaTitle}</h2>
        <a class="button button-light" href={urlFor('get-help', locale)}>
          {t.home.ctaButton}
          <PhosphorIcon name="arrow-up-right" />
        </a>
      </div>
    </section>
  )}
</BaseLayout>
