---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhosphorIcon from './PhosphorIcon.astro';
import { localizedPath, practicePath, workAreas } from '../lib/navigation';
import { copy, facts, urlFor, type Locale, type PageKey } from '../lib/site';

interface Props {
  locale: Locale;
  page: Exclude<PageKey, 'home'>;
}
const { locale, page } = Astro.props;
const t = copy[locale];
const info =
  page === 'about'
    ? t.about
    : page === 'how-we-help'
      ? t.help
      : page === 'our-work'
        ? t.work
        : page === 'get-help'
          ? t.contact
          : page === 'faq'
            ? t.faq
            : page === 'privacy'
              ? t.privacy
              : t.disclaimer;
const eyebrow = 'eyebrow' in info ? info.eyebrow : facts.name;
const heading = 'heading' in info ? info.heading : '';
const intro = 'intro' in info ? info.intro : '';
const sections = 'sections' in info ? info.sections : [];
const isLegal = page === 'privacy' || page === 'disclaimer';
const aidArea = workAreas.find((item) => item.slug === 'legal-aid-initiative')!;
const documentationArea = workAreas.find((item) => item.slug === 'documentation-advisory')!;
---

<BaseLayout locale={locale} page={page} title={info.title} description={info.description}>
  <section class:list={['inner-hero', 'page-wrap', { 'inner-hero-compact': isLegal }]}>
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {intro && <p class="inner-intro">{intro}</p>}
    </div>
    <div class="inner-hero-symbol" aria-hidden="true">
      <span>A.</span>
    </div>
  </section>

  {page === 'about' && (
    <>
      <section class="editorial-section section-pad page-wrap">
        <div class="about-who-grid">
          <h2>{t.about.who.title}</h2>
          <div lang={locale === 'hi' ? 'en' : undefined}>
            <p>{t.about.who.text}</p>
            <p>{t.about.who.name}</p>
          </div>
        </div>
        <div class="editorial-grid about-purpose-grid" lang={locale === 'hi' ? 'en' : undefined}>
          {t.about.sections.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="principles-band">
        <div class="page-wrap">
          <p class="eyebrow">{locale === 'hi' ? 'कानूनी क्षेत्र' : 'Areas of law'}</p>
          <dl class="values-grid" lang={locale === 'hi' ? 'en' : undefined}>
            {t.about.principles.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd>{item.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
      <section class="trust-section section-pad page-wrap">
        <div>
          <p class="eyebrow">{facts.trust}</p>
          <h2>{t.about.trust.title}</h2>
        </div>
        <div class="trust-body">
          <p lang="en">{t.about.trust.text}</p>
          <div class="registration-details">
            <h3>{locale === 'hi' ? 'सूचीबद्ध सहायता' : 'Listed support'}</h3>
            <dl lang="en">
              {t.about.trust.items.map((item, index) => (
                <div>
                  <dt>0{index + 1}</dt>
                  <dd>{item}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>
    </>
  )}

  {page === 'how-we-help' && (
    <section class="section-pad page-wrap">
      <div class="section-heading">
        <h2>{locale === 'hi' ? 'वर्तमान कार्य क्षेत्र' : 'Current areas of work'}</h2>
      </div>
      <div class="area-grid">
        {workAreas.map((item, i) => (
          <article>
            <span>0{i + 1}</span>
            <h3 lang="en">{item.title}</h3>
            <p lang="en">{item.items[0]}</p>
            <a class="text-link" href={localizedPath(practicePath(item.group, item.slug), locale)}>
              {locale === 'hi' ? 'विवरण देखें' : 'View details'}
              <PhosphorIcon name="arrow-up-right" />
            </a>
          </article>
        ))}
      </div>
      <div class="soft-note">
        <p>{t.generalNotice}</p>
      </div>
    </section>
  )}

  {page === 'our-work' && (
    <section class="section-pad page-wrap">
      <div class="work-grid">
        {workAreas.map((item, i) => (
          <article class:list={['work-item', { 'work-item-featured': i === 0 }]}>
            <span class="card-number">0{i + 1}</span>
            <h2 lang="en">{item.title}</h2>
            <p lang="en">{item.items.slice(0, 2).join('; ')}</p>
            <a class="text-link" href={localizedPath(practicePath(item.group, item.slug), locale)}>
              {locale === 'hi' ? 'विवरण देखें' : 'View details'}
              <PhosphorIcon name="arrow-up-right" />
            </a>
          </article>
        ))}
      </div>
      <p class="work-note">{t.work.note}</p>
    </section>
  )}

  {page === 'get-help' && (
    <section class="section-pad page-wrap contact-grid">
      <div>
        <div class="urgent-panel">
          <h2>{t.contact.aidTitle}</h2>
          <ul class="practice-list" lang="en">
            {aidArea.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="contact-information">
          <h2>{locale === 'hi' ? 'सार्वजनिक संपर्क' : 'Direct contact'}</h2>
          {facts.phone ? (
            <a href={`tel:${facts.phone}`}>{facts.phone}</a>
          ) : (
            <p>{t.contact.contactPending}</p>
          )}
          {facts.email && <a href={`mailto:${facts.email}`}>{facts.email}</a>}
          {facts.address && <p>{facts.address}</p>}
          <a
            class="text-link"
            href={localizedPath(practicePath(aidArea.group, aidArea.slug), locale)}
          >
            {locale === 'hi' ? 'कानूनी सहायता का विवरण' : 'View legal aid details'}
            <PhosphorIcon name="arrow-up-right" />
          </a>
        </div>
      </div>
      <div class="preparation-panel">
        <p class="eyebrow">{locale === 'hi' ? 'सेवाएँ' : 'Services'}</p>
        <h2>{t.contact.documentationTitle}</h2>
        <ol class="prepare-list" lang="en">
          {documentationArea.items.map((item, i) => (
            <li>
              <span>0{i + 1}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
        <a
          class="text-link"
          href={localizedPath(
            practicePath(documentationArea.group, documentationArea.slug),
            locale
          )}
        >
          {locale === 'hi' ? 'दस्तावेज़ सेवाओं का विवरण' : 'View documentation details'}
          <PhosphorIcon name="arrow-up-right" />
        </a>
      </div>
    </section>
  )}

  {page === 'faq' && (
    <section class="section-pad page-wrap faq-page">
      <div class="faq-list" lang={locale === 'hi' ? 'en' : undefined}>
        {t.faq.items.map((item) => (
          <details>
            <summary>
              {item.q}
              <PhosphorIcon name="plus" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {isLegal && (
    <section class="section-pad page-wrap legal-page">
      <div class="legal-grid" lang={locale === 'hi' ? 'en' : undefined}>
        {sections.map((item) => (
          <section>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </section>
        ))}
      </div>
    </section>
  )}

  {page !== 'get-help' && !isLegal && (
    <section class="inner-cta">
      <div class="page-wrap">
        <h2>{t.home.ctaTitle}</h2>
        <a class="button button-light" href={urlFor('how-we-help', locale)}>
          {t.home.ctaButton}
          <PhosphorIcon name="arrow-up-right" />
        </a>
      </div>
    </section>
  )}
</BaseLayout>
