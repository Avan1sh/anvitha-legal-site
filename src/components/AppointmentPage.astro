---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppointmentSection from './AppointmentSection.astro';
import { appointmentFormEnabled } from '../lib/appointmentConfig';
import { facts, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const brand = locale === 'hi' ? 'अन्विता लीगल' : facts.name;
const formEnabled = appointmentFormEnabled;
---

<BaseLayout
  locale={locale}
  page="book-appointment"
  title={`${locale === 'hi' ? 'अपॉइंटमेंट बुक करें' : 'Book an appointment'} | ${brand}`}
  description={
    formEnabled
      ? locale === 'hi'
        ? 'अन्विता लीगल से अपॉइंटमेंट का अनुरोध भेजें।'
        : 'Send an appointment request to Anvitha Legal.'
      : locale === 'hi'
        ? 'अन्विता लीगल के अपॉइंटमेंट पेज का पूर्वावलोकन।'
        : 'Preview the Anvitha Legal appointment page.'
  }
  noindex
>
  <AppointmentSection locale={locale} page />
</BaseLayout>
