---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-still-life.png';
import criminalImage from '../assets/expertise/criminal-lawyer.png';
import familyImage from '../assets/expertise/family-disputes-lawyer.png';
import civilImage from '../assets/expertise/civil-lawyer.png';
import bankingImage from '../assets/expertise/cheque-bounce-lawyer.png';
import serviceImage from '../assets/expertise/corporate-lawyer.png';

import aidImage from '../assets/expertise/divorce-lawyer.png';
import marriageImage from '../assets/expertise/matrimonial-lawyer.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath, practicePath, workAreas } from '../lib/navigation';
import PhosphorIcon from './PhosphorIcon.astro';
import { copy, facts, urlFor, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const h = t.home;
const expertiseMedia = {
  'criminal-law': { image: criminalImage, icon: 'gavel' },
  'family-matrimonial-law': { image: familyImage, icon: 'users-three' },
  'civil-law': { image: civilImage, icon: 'scales' },
  'banking-debt-recovery': { image: bankingImage, icon: 'bank' },
  'service-education-law': { image: serviceImage, icon: 'briefcase' },
  'documentation-advisory': { image: heroImage, icon: 'receipt' },
  'legal-aid-initiative': { image: aidImage, icon: 'handshake' },
  'marriage-matrimonial-services': { image: marriageImage, icon: 'heart-break' }
} as const;
const expertiseCards = workAreas.map((card) => ({
  ...card,
  ...expertiseMedia[card.slug as keyof typeof expertiseMedia]
}));
const supportAreas = [workAreas[0], workAreas[1], workAreas[5], workAreas[6]];
const featuredAreas = [workAreas[0], workAreas[1], workAreas[3], workAreas[7]];
---

<BaseLayout locale={locale} page="home" title={h.title} description={h.description}>
  <section class="hero page-wrap">
    <div class="hero-copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1>{h.heading}</h1>
      <p class="hero-intro">{h.intro}</p>
      <div class="hero-actions">
        <a class="button button-dark" href={urlFor('how-we-help', locale)}>
          {h.primary}
          <PhosphorIcon name="arrow-up-right" />
        </a>
        <a class="text-link" href={urlFor('get-help', locale)}>
          {h.secondary}
          <PhosphorIcon name="arrow-right" />
        </a>
      </div>
      <div class="hero-signature">
        <span class="signature-line" aria-hidden="true"></span>
        <span lang={locale === 'hi' ? 'en' : undefined}>{t.initiative}</span>
      </div>
    </div>
    <figure class="hero-visual">
      <Image
        src={heroImage}
        alt=""
        widths={[640, 960, 1280]}
        sizes="(max-width: 760px) 100vw, 52vw"
        format="webp"
        loading="eager"
      />
      <figcaption>{h.imageCaption}</figcaption>
    </figure>
  </section>

  <section class="topic-marquee" aria-label={h.topicsTitle}>
    <div class="marquee-track">
      <div class="marquee-set">
        {h.topics.map((topic) => (
          <span>
            {topic}
            <PhosphorIcon name="diamond" />
          </span>
        ))}
      </div>
      <div class="marquee-set" aria-hidden="true">
        {h.topics.map((topic) => (
          <span>
            {topic}
            <PhosphorIcon name="diamond" />
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="expertise-section section-pad page-wrap" aria-labelledby="expertise-title">
    <div class="expertise-heading">
      <div>
        <p class="eyebrow">{locale === 'hi' ? 'कानूनी क्षेत्र' : 'Areas of work'}</p>
        <h2 id="expertise-title">{locale === 'hi' ? 'हमारी विशेषज्ञता' : 'Our expertise'}</h2>
      </div>
      <p>
        {locale === 'hi'
          ? 'किसी कार्ड को खोलकर उससे जुड़े कार्य देखें।'
          : 'Open a card to see the work listed in that area.'}
      </p>
    </div>
    <div class="expertise-grid">
      {expertiseCards.map((card) => (
        <a class="expertise-card" href={`#expertise-${card.slug}`}>
          <div class="expertise-card-image">
            <Image
              src={card.image}
              alt=""
              widths={[320, 480, 640]}
              sizes="(max-width: 600px) 38vw, (max-width: 1100px) 50vw, 25vw"
              format="webp"
              loading="lazy"
            />
          </div>
          <div class="expertise-card-content">
            <span class="expertise-card-icon">
              <PhosphorIcon name={card.icon} />
            </span>
            <h3 lang="en">{card.title}</h3>
            <p lang="en">{card.items[0]}</p>
            <span class="expertise-card-link">
              {card.items.length} {locale === 'hi' ? 'विषय देखें' : 'topics · Open card'}
              <PhosphorIcon name="arrow-right" />
            </span>
          </div>
        </a>
      ))}
    </div>
    <div class="expertise-panels">
      {expertiseCards.map((card, index) => (
        <section
          id={`expertise-${card.slug}`}
          class="expertise-panel"
          tabindex="-1"
          aria-labelledby={`expertise-panel-title-${card.slug}`}
        >
          <div class="expertise-panel-head">
            <div>
              <p class="eyebrow">
                {locale === 'hi' ? 'कार्य क्षेत्र' : 'Area of work'} {index + 1} /{' '}
                {expertiseCards.length}
              </p>
              <h3 id={`expertise-panel-title-${card.slug}`} lang="en">
                {card.title}
              </h3>
            </div>
            <a
              class="expertise-panel-close"
              href="#expertise-title"
              aria-label={locale === 'hi' ? 'विषय बंद करें' : 'Close topics'}
            >
              <PhosphorIcon name="plus" />
            </a>
          </div>
          {locale === 'hi' && (
            <p class="expertise-language-note">विस्तृत विषय अभी अंग्रेज़ी में उपलब्ध हैं।</p>
          )}
          <ul class="expertise-topic-list" lang="en">
            {card.items.map((item) => (
              <li>
                <strong>{item}</strong>
              </li>
            ))}
          </ul>
          <div class="expertise-related">
            <h4>{locale === 'hi' ? 'विस्तृत पेज' : 'Detailed page'}</h4>
            <div>
              <a href={localizedPath(practicePath(card.group, card.slug), locale)} lang="en">
                {card.title}
                <PhosphorIcon name="arrow-up-right" />
              </a>
            </div>
          </div>
          <div class="expertise-panel-foot">
            <p>{t.generalNotice}</p>
            <nav aria-label={locale === 'hi' ? 'कानूनी क्षेत्र बदलें' : 'Browse areas of work'}>
              <a
                href={`#expertise-${expertiseCards[(index + expertiseCards.length - 1) % expertiseCards.length].slug}`}
              >
                {locale === 'hi' ? 'पिछला' : 'Previous'}
              </a>
              <a href={`#expertise-${expertiseCards[(index + 1) % expertiseCards.length].slug}`}>
                {locale === 'hi' ? 'अगला' : 'Next'}
                <PhosphorIcon name="arrow-right" />
              </a>
            </nav>
          </div>
        </section>
      ))}
    </div>
  </section>
  <section class="support-section section-pad page-wrap" id="support">
    <div class="section-heading">
      <p class="eyebrow">{locale === 'hi' ? 'हमारी सहायता' : 'What we do'}</p>
      <h2>{h.supportTitle}</h2>
      <p>{h.supportIntro}</p>
    </div>
    <div class="support-grid">
      {h.services.map((service, i) => (
        <a
          class={`support-card support-card-${i + 1}`}
          href={localizedPath(practicePath(supportAreas[i].group, supportAreas[i].slug), locale)}
        >
          <span class="card-number">{service.number}</span>
          <div lang={locale === 'hi' ? 'en' : undefined}>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </div>
          <PhosphorIcon name="arrow-up-right" class="card-arrow" />
        </a>
      ))}
    </div>
  </section>

  <section class="approach-section section-pad" data-motion-root>
    <div class="page-wrap approach-grid">
      <div class="approach-intro">
        <p class="eyebrow">{locale === 'hi' ? 'हमारा तरीका' : 'A thoughtful process'}</p>
        <h2>{h.approachTitle}</h2>
        <p>{h.approachIntro}</p>
        <a class="text-link" href={urlFor('about', locale)}>
          {t.nav.about}
          <PhosphorIcon name="arrow-right" />
        </a>
      </div>
      <div class="approach-steps">
        {h.steps.map((step, i) => (
          <article class="approach-step">
            <span>0{i + 1}</span>
            <div lang={locale === 'hi' ? 'en' : undefined}>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="topics-section section-pad page-wrap">
    <div class="topics-title">
      <p class="eyebrow">{locale === 'hi' ? 'चुनिंदा क्षेत्र' : 'Selected areas'}</p>
      <h2 data-text-reveal>{h.topicsTitle}</h2>
    </div>
    <div class="topic-list">
      {h.topics.map((topic, i) => (
        <a
          href={localizedPath(practicePath(featuredAreas[i].group, featuredAreas[i].slug), locale)}
        >
          <span>0{i + 1}</span>
          <strong lang={locale === 'hi' ? 'en' : undefined}>{topic}</strong>
          <PhosphorIcon name="arrow-up-right" />
        </a>
      ))}
    </div>
  </section>

  <section class="work-teaser section-pad">
    <div class="page-wrap work-teaser-grid">
      <div class="work-visual" aria-hidden="true">
        <div class="work-visual-inner">
          <span>A.</span>
          <div class="work-visual-lines">
            <i></i>
            <i></i>
            <i></i>
          </div>
        </div>
      </div>
      <div class="work-teaser-copy">
        <p class="eyebrow">{locale === 'hi' ? 'हमारा कार्य' : 'Our work'}</p>
        <h2>{h.workTitle}</h2>
        <p>{h.workText}</p>
        <a class="text-link" href={urlFor('our-work', locale)}>
          {h.workLink}
          <PhosphorIcon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>

  <section class="faq-teaser section-pad page-wrap">
    <div class="section-heading">
      <p class="eyebrow">{locale === 'hi' ? 'सवाल-जवाब' : 'Good to know'}</p>
      <h2>{t.faq.heading}</h2>
    </div>
    <div class="faq-list" lang={locale === 'hi' ? 'en' : undefined}>
      {t.faq.items.slice(0, 3).map((item) => (
        <details>
          <summary>
            {item.q}
            <PhosphorIcon name="plus" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
    <a class="text-link faq-more" href={urlFor('faq', locale)}>
      {t.nav.faq}
      <PhosphorIcon name="arrow-right" />
    </a>
  </section>

  <section class="closing-cta section-pad">
    <div class="page-wrap">
      <p class="eyebrow">{facts.name}</p>
      <h2>{h.ctaTitle}</h2>
      <p>{h.ctaText}</p>
      <a class="button button-light" href={urlFor('how-we-help', locale)}>
        {h.ctaButton}
        <PhosphorIcon name="arrow-up-right" />
      </a>
    </div>
  </section>
</BaseLayout>
<script>
  import '../scripts/motion';
</script>
