---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhosphorIcon from './PhosphorIcon.astro';
import { headerLabels } from '../lib/navigation';
import { facts, urlFor, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  kind: 'contact' | 'book-appointment';
}

const { locale, kind } = Astro.props;
const isContact = kind === 'contact';
const label = isContact ? headerLabels[locale].contact : headerLabels[locale].appointment;
const brand = locale === 'hi' ? 'अन्विता लीगल' : facts.name;
const intro = isContact
  ? locale === 'hi'
    ? 'सीधे सार्वजनिक फोन, ईमेल और कार्यालय विवरण अभी उपलब्ध नहीं कराए गए हैं।'
    : 'Direct public phone, email and office details have not been provided yet.'
  : locale === 'hi'
    ? 'इस पूर्वावलोकन में अपॉइंटमेंट अनुरोध भेजना उपलब्ध नहीं है।'
    : 'Appointment requests cannot be sent through this preview.';
---

<BaseLayout
  locale={locale}
  page={kind}
  path={`/${kind}`}
  title={`${label} | ${brand}`}
  description={intro}
  noindex
>
  <section class="inner-hero page-wrap">
    <div>
      <p class="eyebrow">{label}</p>
      <h1>{label}</h1>
      <p class="inner-intro">{intro}</p>
      <a class="text-link status-link" href={urlFor('how-we-help', locale)}>
        {locale === 'hi' ? 'कार्य क्षेत्र देखें' : 'View areas of work'}
        <PhosphorIcon name="arrow-right" />
      </a>
    </div>
    <div class="inner-hero-symbol" aria-hidden="true">
      <span>A.</span>
    </div>
  </section>
</BaseLayout>
